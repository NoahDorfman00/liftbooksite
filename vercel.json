{
    "cleanUrls": true,
    "trailingSlash": false,
    "rewrites": [
        { "source": "/get", "destination": "/api/get" },
        { "source": "/x", "destination": "/api/get?ct=x&card=x" },
        { "source": "/:ct(ig|tt|yt)", "destination": "/api/get?ct=:ct" }
    ],
    "headers": [
        {
            "source": "/.well-known/apple-app-site-association",
            "headers": [{ "key": "Content-Type", "value": "application/json" }]
        }
    ]
}
